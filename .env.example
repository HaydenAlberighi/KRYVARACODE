# Environment Variables for KRYVARACODE AI System Stack
# Copy to .env and adjust. Keys mirror src/core/config.py Settings fields
# (pydantic-settings, case_sensitive=True — env var names match field names).

# Application Settings
APP_NAME=KRYVARACODE
APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1
PROJECT_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins (empty disables CORS)
# BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Database Settings
DATABASE_URL=postgresql://user:password@localhost:5432/kryvaracode
REDIS_URL=redis://localhost:6379/0

# MLflow Settings (for experiment tracking)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MODEL_NAME=kryvara_model

# Object Storage (for models and data)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_MODELS=kryvara-models
MINIO_BUCKET_DATA=kryvara-data

# Local Data Storage
DATA_DIR=data

# API Keys (example services)
OPENAI_API_KEY=your_openai_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Monitoring & Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_PORT=16686

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_DEFAULT=100/minute

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=kryvara_rag
QDRANT_VECTOR_SIZE=384
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=100
QDRANT_ENABLE_HYBRID=true
QDRANT_SPARSE_VECTOR_NAME=bm25
QDRANT_DENSE_VECTOR_NAME=dense

# E2B Secure Sandbox
E2B_API_KEY=
E2B_TEMPLATE_ID=base
E2B_TIMEOUT_SECONDS=60
E2B_ENABLED=false
E2B_CPU_LIMIT=1.0
E2B_MEMORY_LIMIT_MB=512